{
  "name": "@bookmarked/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:mutation": "stryker run",
    "test:coverage": "mkdir -p coverage && tsx --test --test-concurrency=1 --experimental-test-coverage --test-coverage-lines=95 --test-coverage-exclude='tests/**' --test-coverage-exclude='src/database/**' --test-coverage-exclude='src/**/*-dto.ts' --test-coverage-exclude='src/server.ts' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"tests/**/*.test.ts\"",
    "test": "tsx --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/database/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/database/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:init": "docker exec -i bookmarked-db psql -U postgres -d bookmarked_dev < src/database/schema.sql"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stryker-mutator/core": "^10.1.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "jose": "^6.2.15",
    "lru-cache": "^11.5.3",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4"
  }
}
