PORT=3000

# Local PostgreSQL database
DATABASE_URL=postgresql://postgres:password123@localhost:5432/bookmarked_dev
DATABASE_URL_TEST=postgresql://postgres:password123@localhost:5432/bookmarked_test

# Note for Supabase / Render:
# Use Supabase transaction/session pooler connection string (IPv4 compatible)
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres


# Supabase Auth: the project URL (same value as the frontend's VITE_SUPABASE_URL).
# Session tokens are verified with the project's JWKS (asymmetric JWT signing keys).
SUPABASE_URL=
# Only if the project still signs tokens with the legacy shared secret (HS256).
SUPABASE_JWT_SECRET=
# Only for `pnpm db:seed`, which creates confirmed seed logins through the Admin API.
# Project Settings > API Keys: the service_role key or a secret key (sb_secret_...).
# Full admin access: keep it here, never in the frontend or in Render's frontend settings.
SUPABASE_SERVICE_ROLE_KEY=
# `pnpm db:seed` refuses a DATABASE_URL that is not local unless this is true.
SEED_ALLOW_REMOTE_DATABASE=false

# Proxies in front of the API, so rate limits see the client's IP (1 on Render).
TRUST_PROXY=0

# Frontend origins allowed by CORS, comma-separated (e.g. https://bookmarked-les.onrender.com).
# Empty allows any origin, for local development.
CORS_ORIGINS=

# Open Library, asked when a book search finds fewer than 5 local books.
OPEN_LIBRARY_URL=https://openlibrary.org
